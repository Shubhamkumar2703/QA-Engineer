# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# Postgres
POSTGRES_DB=qa_agent
POSTGRES_USER=qa_agent
POSTGRES_PASSWORD=changeme

# AI
ANTHROPIC_API_KEY=

# Swagger / target API under test
SWAGGER_BASE_URL=
SWAGGER_SPEC_URL=

# HTTP Executor auth (03-http-executor.json) - resolved credential for
# API Request Contracts whose authentication.type is "bearer" / "api_key".
# The contract itself never carries a real secret (see ADR 002) - this is
# where the HTTP Executor actually attaches one at execution time.
API_AUTH_BEARER_TOKEN=
API_AUTH_API_KEY_HEADER=X-API-Key
API_AUTH_API_KEY_VALUE=

# Jira
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
